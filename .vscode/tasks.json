{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (aria-shell)",
            "type": "shell",
            "command": "cargo build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
